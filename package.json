{
  "name": "officeagent-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "dump": "tsx scripts/dump.ts",
    "icons": "tsx scripts/make-icons.ts",
    "validate": "office-addin-manifest validate manifest.xml",
    "build:pages": "tsc && vite build --base=/OfficeAgent-Web/ && tsx scripts/make-manifest.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.609",
    "office-addin-dev-certs": "^3.0.0",
    "office-addin-manifest": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
